# Variables de entorno - Switch de Pagos BanQuito

# API Configuration
# Pruebas locales R9I: Core/Auth usa 8000 y Switch usa Kong switch-only en 8010.
VITE_CORE_KONG_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8010/api/v1

# Application Settings
VITE_APP_NAME=BanQuito
VITE_APP_SUBTITLE=Switch Pagos Masivos
VITE_ENVIRONMENT=development

# Vite Server Configuration
VITE_BASE_PATH=/switch/
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=5173
# Multiple hosts separated by commas
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Authentication
VITE_MOCK_AUTH_ENABLED=false
VITE_DEFAULT_ADMIN_USER=admin
